{
  "sleep": 0,
  "steps": [
    {
      "message": "create the parts for a small AC/DC supply block",
      "diff": {
        "add_parts": [
          {
            "id": "PSU",
            "description": "AC/DC power supply module 230VAC to 24VDC",
            "prefix": "PS",
            "pins": [
              {"name": "L", "side": "left"},
              {"name": "N", "side": "left"},
              {"name": "PE", "side": "left"},
              {"name": "+V", "side": "right"},
              {"name": "0V", "side": "right"}
            ]
          }
        ]
      }
    },
    {
      "message": "add terminals, fuse and the PSU",
      "diff": {
        "add_components": [
          {"library_id": "TERM", "id": "x1", "ref": "X1", "value": "230V L/N/PE", "sheet": 1},
          {"library_id": "FUSE", "id": "f1", "ref": "F1", "value": "6A", "sheet": 1},
          {"library_id": "PSU", "id": "ps1", "ref": "PS1", "value": "230VAC->24VDC", "sheet": 1},
          {"library_id": "TERM", "id": "x2", "ref": "X2", "value": "24V out", "sheet": 1}
        ]
      }
    },
    {
      "message": "wire mains through the fuse to the PSU and the 24V rail to the output terminals",
      "diff": {
        "add_nets": [
          {"name": "L", "role": "power", "pins": ["x1.1", "f1.A"]},
          {"name": "L_F", "role": "power", "pins": ["f1.B", "ps1.L"]},
          {"name": "N", "role": "power", "pins": ["x1.2", "ps1.N"]},
          {"name": "PE", "role": "ground", "pins": ["ps1.PE"]},
          {"name": "+24V", "role": "power", "pins": ["ps1.+V", "x2.1"]},
          {"name": "0V", "role": "ground", "pins": ["ps1.0V", "x2.2"]}
        ]
      }
    }
  ]
}